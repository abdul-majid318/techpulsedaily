# Public deployment configuration. Do not commit real secrets to this file.
# Replace these values only after the publisher has verified them.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
NEXT_PUBLIC_PUBLISHER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Keep both false until the publisher has approved actual vendors and consent requirements.
NEXT_PUBLIC_OPTIONAL_COOKIES_ENABLED=false
NEXT_PUBLIC_AD_PLACEMENTS_ENABLED=false
# Local editorial preview only. Never set this to true in production: it makes
# draft and review-required content available to local static rendering.
EDITORIAL_PREVIEW=false
